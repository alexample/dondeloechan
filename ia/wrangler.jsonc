// Configuración del asistente para Cloudflare (Workers Builds la lee al desplegar desde GitHub).
{
  "name": "dondeloechan-ia",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // Conserva las variables puestas a mano en el panel de Cloudflare al desplegar desde GitHub
  "keep_vars": true,
  "ai": { "binding": "AI" },
  // Valoraciones (estrellas) de las carreras de RunningSpain
  "kv_namespaces": [{ "binding": "VALORA", "id": "5c70a2cfae3a4479b81359311d6e99c1" }],
  // Cada hora, a los :07, el worker avisa a GitHub para que pase el robot de datos (más puntual que el horario de GitHub).
  // Cada 20 min: pasadas rápidas de resultados de Cantera Madrid (solo fines de semana; el worker filtra la hora).
  "triggers": { "crons": ["7 * * * *", "*/20 * * * *"] }
}
